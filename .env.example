# Copy to .env and adjust. Without DATABASE_URL the backend falls back to SQLite.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://moneta:moneta@localhost:5432/moneta
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres container (docker compose)
POSTGRES_DB=moneta
POSTGRES_USER=moneta
POSTGRES_PASSWORD=moneta
